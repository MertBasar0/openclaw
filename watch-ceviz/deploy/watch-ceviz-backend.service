[Unit]
Description=Watch Ceviz Backend (PTT->Summary, local Whisper STT)
After=network-online.target openclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/mertb/.openclaw/ceviz-recovery/restored/watch-ceviz
Environment=HOME=/home/mertb
Environment=PATH=/home/mertb/.local/bin:/usr/local/bin:/usr/bin:/bin:/home/mertb/.nvm/versions/node/v22.22.2/bin
Environment=WATCH_CEVIZ_STT_ENGINE=auto
Environment=WATCH_CEVIZ_WHISPER_MODEL=small
Environment=WATCH_CEVIZ_WHISPER_LANGUAGE=tr
Environment=OPENCLAW_WATCH_AGENT=main
# Uretimde zorunlu: openssl rand -hex 24 ile uret, telefonda Ayarlar ekranina gir
Environment=WATCH_CEVIZ_AUTH_TOKEN=CHANGE_ME
ExecStart=/home/mertb/.openclaw/ceviz-recovery/restored/watch-ceviz/.venv/bin/python /home/mertb/.openclaw/ceviz-recovery/restored/watch-ceviz/backend/main.py 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
